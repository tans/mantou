  "lines": [
    {
      "id": "line-001",
      "speaker": "narrator",
      "text": "Unit five. The weather and us.",
      "zh": "第五单元：天气与我们。",
      "status": "verified",
      "shot": "shot-01"
    },
    {
      "id": "line-002",
      "speaker": "narrator",
      "text": "How can the weather change our lives?",
      "zh": "天气会怎样改变我们的生活？",
      "status": "verified",
      "shot": "shot-02"
    },
    {
      "id": "line-003",
      "speaker": "kazama",
      "text": "What's the weather like in Beijing?",
      "zh": "北京的天气怎么样？",
      "status": "verified",
      "shot": "shot-03"
    },
    {
      "id": "line-004",
      "speaker": "nene",
      "text": "It's cool and sunny.",
      "zh": "天气凉爽，阳光明媚。",
      "status": "verified",
      "shot": "shot-03"
    },
    {
      "id": "line-005",
      "speaker": "shinchan",
      "text": "It's sunny today.",
      "zh": "今天阳光明媚。",
      "status": "verified",
      "shot": "shot-04"
    },
    {
      "id": "line-006",
      "speaker": "shinchan",
      "text": "I do sports and I play.",
      "zh": "我做运动，也玩耍。",
      "status": "verified",
      "shot": "shot-04"
    },
    {
      "id": "line-007",
      "speaker": "kazama",
      "text": "It's windy today.",
      "zh": "今天有风。",
      "status": "verified",
      "shot": "shot-05"
    },
    {
      "id": "line-008",
      "speaker": "kazama",
      "text": "I fly a kite and I play.",
      "zh": "我放风筝，也玩耍。",
      "status": "verified",
      "shot": "shot-05"
    },
    {
      "id": "line-009",
      "speaker": "nene",
      "text": "It's snowy today.",
      "zh": "今天下雪。",
      "status": "verified",
      "shot": "shot-06"
    },
    {
      "id": "line-010",
      "speaker": "nene",
      "text": "I make a snowman and I play.",
      "zh": "我堆雪人，也玩耍。",
      "status": "verified",
      "shot": "shot-06"
    },
    {
      "id": "line-011",
      "speaker": "shinchan",
      "text": "It's rainy today.",
      "zh": "今天下雨。",
      "status": "verified",
      "shot": "shot-07"
    },
    {
      "id": "line-012",
      "speaker": "shinchan",
      "text": "I stay at home and I wait.",
      "zh": "我待在家里等待。",
      "status": "verified",
      "shot": "shot-07"
    },
    {
      "id": "line-013",
      "speaker": "kazama",
      "text": "It's raining now.",
      "zh": "现在正在下雨。",
      "status": "verified",
      "shot": "shot-08"
    },
    {
      "id": "line-014",
      "speaker": "shinchan",
      "text": "Oh no! We can't play basketball in the park.",
      "zh": "哦，不！我们不能在公园打篮球了。",
      "status": "verified",
      "shot": "shot-08"
    },
    {
      "id": "line-015",
      "speaker": "kazama",
      "text": "It's OK. We can go to the library.",
      "zh": "没关系。我们可以去图书馆。",
      "status": "verified",
      "shot": "shot-09"
    },
    {
      "id": "line-016",
      "speaker": "shinchan",
      "text": "But it's closed now.",
      "zh": "可是它现在关门了。",
      "status": "verified",
      "shot": "shot-09"
    },
    {
      "id": "line-017",
      "speaker": "kazama",
      "text": "Hmm. Let's go and see a film.",
      "zh": "嗯。我们去看电影吧。",
      "status": "verified",
      "shot": "shot-10"
    },
    {
      "id": "line-018",
      "speaker": "shinchan",
      "text": "That's a good idea!",
      "zh": "好主意！",
      "status": "verified",
      "shot": "shot-10"
    }
  ],
